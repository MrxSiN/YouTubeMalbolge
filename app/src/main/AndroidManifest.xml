<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.google.android.youtube" />
    </queries>
    <application
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@drawable/ytm_hellfire"
        android:label="@string/app_name">
        <!-- Generated from source/40_manager; YouTube's settings entry launches it explicitly. -->
        <activity
            android:name="io.github.mrxsin.ytmalbolge.generated.ManagerActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/YouTubeMalbolgeTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name="io.github.mrxsin.ytmalbolge.generated.DiagnosticReceiver"
            android:exported="true" />
    </application>
</manifest>
